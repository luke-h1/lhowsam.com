{
  "name": "lhowsam.com",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro preview --host 127.0.0.1 --port 3000",
    "astro": "astro",
    "sync": "astro sync",
    "prettier:check": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,css,scss,html}\"",
    "prettier:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,html}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "ts:check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:install-browsers": "playwright install --with-deps chromium",
    "e2e:local": "BASE_URL='http://127.0.0.1:3000' playwright test",
    "e2e:local:open": "BASE_URL='http://127.0.0.1:3000' playwright test --headed",
    "e2e:dev": "BASE_URL='https://dev.lhowsam.com' playwright test",
    "e2e:dev:open": "BASE_URL='https://dev.lhowsam.com' playwright test --headed",
    "e2e:prod": "BASE_URL='https://lhowsam.com' playwright test",
    "e2e:prod:open": "BASE_URL='https://lhowsam.com' playwright test --headed",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.1",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.3",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/instrument-serif": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@fontsource/roboto-mono": "5.2.8",
    "@fontsource/source-sans-pro": "5.2.5",
    "@sentry/astro": "^10.47.0",
    "@statsig/js-client": "^3.32.3",
    "@statsig/react-bindings": "^3.32.3",
    "@statsig/web-analytics": "^3.32.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.0.8",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-astro": "^0.556.0",
    "lucide-react": "0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "^16.2.1",
    "@playwright/test": "^1.59.1",
    "@shikijs/transformers": "^4.0.2",
    "@shikijs/twoslash": "^4.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^2.0.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,html,astro,md,mdx,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
