---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import { timelineRoles } from '../../data/experience.ts';
import type { CommandMenuGroup, CommandMenuItem } from '../../util/commandMenu';
import CommandMenu from './CommandMenu.tsx';
import SocialLinks from './SocialLinks.astro';

const pathname = new URL(Astro.request.url).pathname;
const [blogPosts, projectPosts, talkEntries] = await Promise.all([
  getCollection('blog'),
  getCollection('projects'),
  getCollection('talks'),
]);

const isActive = (path: string) => {
  if (path === '/') {
    return pathname === '/';
  }
  return pathname.startsWith(path);
};

interface NavItem {
  name: string;
  path: string;
}

const navItems: NavItem[] = [
  {
    name: 'Home',
    path: '/',
  },
  {
    name: 'About',
    path: '/about',
  },
  {
    name: 'Projects',
    path: '/projects',
  },
  {
    name: 'Work',
    path: '/work-projects',
  },
  {
    name: 'Blog',
    path: '/blog',
  },
];

const commandNavItems: NavItem[] = [
  ...navItems,
  {
    name: 'Talks',
    path: '/talks',
  },
];

const commandGroups = [
  {
    heading: 'Navigation',
    items: commandNavItems.map(link => ({
      id: `nav-${link.path}`,
      label: link.name,
      searchText: `${link.name} navigation page`,
      type: 'internal-link',
      href: link.path,
    })),
  },
  {
    heading: 'Blog',
    items: blogPosts
      .filter(post => !post.data.draft)
      .map(post => ({
        id: `blog-${post.data.slug}`,
        label: post.data.title,
        searchText: [post.data.title, post.data.intro, ...post.data.tags].join(
          ' ',
        ),
        type: 'internal-link',
        href: `/blog/${post.data.slug}/`,
        section: 'Blog',
      })),
  },
  {
    heading: 'Talks',
    items: talkEntries
      .filter(t => !t.data.draft)
      .map(talk => ({
        id: `talk-${talk.data.slug}`,
        label: talk.data.title,
        searchText: [talk.data.title, talk.data.intro, talk.data.location].join(
          ' ',
        ),
        type: 'internal-link',
        href: `/talks/${talk.data.slug}/`,
        section: 'Talks',
      })),
  },
  {
    heading: 'Projects',
    items: projectPosts.map(project => ({
      id: `project-${project.data.slug}`,
      label: project.data.title,
      searchText: [
        project.data.title,
        project.data.intro,
        ...(project.data.tags ?? []),
        ...(project.data.techStack?.map(tech => tech.name) ?? []),
      ].join(' '),
      type: 'internal-link',
      href: `/projects/${project.data.slug}/`,
      section: 'Projects',
    })),
  },
  {
    heading: 'Experience',
    items: timelineRoles.map(role => ({
      id: `experience-${role.anchor}`,
      label: `${role.title} · ${role.company}`,
      searchText: [
        role.title,
        role.company,
        role.location,
        role.summary,
        ...role.techStack,
        ...role.achievements,
      ].join(' '),
      type: 'internal-link',
      href: `/about#${role.anchor}`,
      section: 'Experience',
    })),
  },
  {
    heading: 'Social',
    items: siteConfig.socialLinks.map(link => ({
      id: `social-${link.name.toLowerCase()}`,
      label: link.name,
      searchText: `${link.name} social external`,
      type: 'external-link',
      href: link.url,
    })),
  },
  {
    heading: 'Commands',
    items: [
      {
        id: 'command-copy-url',
        label: 'Copy current URL',
        searchText: 'copy current url link clipboard',
        type: 'copy-url',
      },
    ],
  },
].filter(
  group => group.items.length > 0,
) as CommandMenuGroup<CommandMenuItem>[];
---

<nav class="header-nav" data-header-nav aria-label="Main">
  <div class="header-nav__bar">
    <button
      type="button"
      class="header-nav__burger"
      data-nav-burger
      aria-expanded="false"
      aria-controls="header-nav-panel"
      aria-label="Open menu"
    >
      <span class="header-nav__burger-lines" aria-hidden="true"></span>
    </button>
    <div id="header-nav-panel" class="header-nav__panel">
      <button
        type="button"
        class="header-nav__backdrop"
        data-nav-backdrop
        tabindex="-1"
        aria-hidden="true"></button>
      <div class="header-nav__sheet" data-nav-sheet tabindex="-1">
        <div class="header-nav__sheet-head" data-nav-drag>
          <span class="header-nav__grabber" aria-hidden="true"></span>
          <p id="header-nav-sheet-title" class="header-nav__sheet-title">
            Menu
          </p>
          <button
            type="button"
            class="header-nav__close"
            data-nav-close
            aria-label="Close menu"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M4 4l8 8M12 4l-8 8"></path>
            </svg>
          </button>
        </div>
        <div class="header-nav__links">
          {
            commandNavItems.map(link => (
              <a
                href={link.path}
                class:list={[
                  'header-nav__link',
                  isActive(link.path) && 'active',
                  !navItems.includes(link) && 'header-nav__link--mobile',
                ]}
                aria-current={isActive(link.path) ? 'page' : undefined}
                data-nav-link
              >
                <span class="header-nav__label">{link.name}</span>
                <svg
                  class="header-nav__chevron"
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                >
                  <path d="M6 3.5L10.5 8 6 12.5" />
                </svg>
              </a>
            ))
          }
        </div>
        <div class="header-nav__meta">
          <SocialLinks size={20} />
        </div>
      </div>
    </div>
    <CommandMenu client:idle groups={commandGroups} />
  </div>
</nav>

<script is:inline>
  (() => {
    const nav = document.querySelector('[data-header-nav]');
    if (!nav || !(nav instanceof HTMLElement)) return;

    const burger = nav.querySelector('[data-nav-burger]');
    const panel = nav.querySelector('#header-nav-panel');
    const backdrop = nav.querySelector('[data-nav-backdrop]');
    const links = nav.querySelectorAll('[data-nav-link]');
    const sheet = nav.querySelector('[data-nav-sheet]');
    const dragHandle = nav.querySelector('[data-nav-drag]');
    const closeButton = nav.querySelector('[data-nav-close]');
    const mq = window.matchMedia('(max-width: 480px)');

    if (
      !burger ||
      !panel ||
      !(burger instanceof HTMLButtonElement) ||
      !(panel instanceof HTMLElement)
    ) {
      return;
    }

    const syncPanelHidden = () => {
      if (sheet instanceof HTMLElement) {
        if (mq.matches) {
          sheet.setAttribute('role', 'dialog');
          sheet.setAttribute('aria-modal', 'true');
          sheet.setAttribute('aria-labelledby', 'header-nav-sheet-title');
        } else {
          sheet.removeAttribute('role');
          sheet.removeAttribute('aria-modal');
          sheet.removeAttribute('aria-labelledby');
        }
      }
      if (!mq.matches) {
        panel.removeAttribute('aria-hidden');
        return;
      }
      panel.setAttribute(
        'aria-hidden',
        nav.classList.contains('header-nav--open') ? 'false' : 'true',
      );
    };

    const inerted = [];

    const setOutsideInert = inert => {
      if (!inert) {
        inerted.splice(0).forEach(el => {
          el.inert = false;
        });
        return;
      }
      for (let node = nav; node && node !== document.body; ) {
        const parent = node.parentElement;
        if (!parent) break;
        for (const sibling of parent.children) {
          if (sibling !== node && !sibling.inert) {
            sibling.inert = true;
            inerted.push(sibling);
          }
        }
        node = parent;
      }
    };

    const setOpen = open => {
      const wasOpen = nav.classList.contains('header-nav--open');
      const modal = open && mq.matches;
      nav.classList.toggle('header-nav--open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      syncPanelHidden();
      document.body.style.overflow = modal ? 'hidden' : '';
      setOutsideInert(modal);
      if (modal && !wasOpen) {
        sheet?.focus({ preventScroll: true });
      }
    };

    const close = () => setOpen(false);

    burger.addEventListener('click', () => {
      setOpen(!nav.classList.contains('header-nav--open'));
    });

    backdrop?.addEventListener('click', close);

    closeButton?.addEventListener('click', () => {
      close();
      burger.focus();
    });

    if (sheet instanceof HTMLElement && dragHandle instanceof HTMLElement) {
      let drag = null;

      const resetDragStyles = () => {
        sheet.style.transform = '';
        sheet.style.transition = '';
        if (backdrop instanceof HTMLElement) {
          backdrop.style.opacity = '';
          backdrop.style.transition = '';
        }
      };

      dragHandle.addEventListener('pointerdown', e => {
        if (e.button !== 0 || e.target.closest('button')) return;
        dragHandle.setPointerCapture(e.pointerId);
        drag = {
          startY: e.clientY,
          lastY: e.clientY,
          lastT: e.timeStamp,
          velocity: 0,
          height: sheet.offsetHeight,
        };
        sheet.style.transition = 'none';
        if (backdrop instanceof HTMLElement) {
          backdrop.style.transition = 'none';
        }
      });

      dragHandle.addEventListener('pointermove', e => {
        if (!drag) return;
        const dy = e.clientY - drag.startY;
        const dt = e.timeStamp - drag.lastT;
        if (dt > 0) {
          drag.velocity = (e.clientY - drag.lastY) / dt;
        }
        drag.lastY = e.clientY;
        drag.lastT = e.timeStamp;
        const offset = dy > 0 ? dy : dy / 6;
        sheet.style.transform = `translateY(${offset}px)`;
        if (backdrop instanceof HTMLElement) {
          backdrop.style.opacity = String(
            1 - Math.max(0, offset) / drag.height,
          );
        }
      });

      const endDrag = e => {
        if (!drag) return;
        const dy = e.clientY - drag.startY;
        const shouldClose =
          e.type === 'pointerup' &&
          (dy > drag.height * 0.3 || (dy > 0 && drag.velocity > 0.5));
        drag = null;
        resetDragStyles();
        if (shouldClose) {
          close();
          burger.focus();
        }
      };

      dragHandle.addEventListener('pointerup', endDrag);
      dragHandle.addEventListener('pointercancel', endDrag);
    }

    links.forEach(a => {
      a.addEventListener('click', close);
    });

    window.addEventListener('keydown', e => {
      if (e.key === 'Escape' && nav.classList.contains('header-nav--open')) {
        close();
        burger.focus();
      }
    });

    const onViewportChange = () => {
      if (!mq.matches) {
        close();
      }
      syncPanelHidden();
    };

    mq.addEventListener('change', onViewportChange);
    syncPanelHidden();

    window.addEventListener('resize', onViewportChange, { passive: true });
  })();
</script>

<style>
  .header-nav {
    width: 100%;
  }

  .header-nav__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    width: 100%;
  }

  .header-nav__burger {
    display: none;
    margin-right: auto;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-color);
    cursor: pointer;
    transition:
      background var(--transition-base),
      border-color var(--transition-base);
  }

  .header-nav__burger:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .header-nav__burger:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--bg-color),
      0 0 0 4px rgba(var(--accent-rgb), 0.45);
  }

  .header-nav__burger-lines {
    position: relative;
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  .header-nav__burger-lines::before,
  .header-nav__burger-lines::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  .header-nav__burger-lines::before {
    top: -6px;
  }

  .header-nav__burger-lines::after {
    top: 6px;
  }

  .header-nav__panel {
    display: contents;
  }

  .header-nav__backdrop {
    display: none;
  }

  .header-nav__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
    justify-content: flex-start;
    margin-right: auto;
  }

  .header-nav__link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-base);
    position: relative;
    white-space: nowrap;
  }

  .header-nav__link:hover {
    color: var(--text-color);
  }

  .header-nav__link.active {
    color: var(--text-color) !important;
  }

  .header-nav__link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--text-muted);
  }

  @media (max-width: 640px) {
    .header-nav__link {
      font-size: 0.8125rem;
    }
  }

  .header-nav__sheet {
    display: contents;
  }

  .header-nav__link--mobile,
  .header-nav__sheet-head,
  .header-nav__chevron,
  .header-nav__meta {
    display: none;
  }

  @media (max-width: 480px) {
    .header-nav__burger {
      display: inline-flex;
    }

    .header-nav__panel {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 300;
      pointer-events: none;
      visibility: hidden;
      transition: visibility 0s linear 0.5s;
    }

    .header-nav--open .header-nav__panel {
      pointer-events: auto;
      visibility: visible;
      transition: none;
    }

    .header-nav__backdrop {
      display: block;
      position: absolute;
      inset: 0;
      border: 0;
      padding: 0;
      margin: 0;
      background: rgba(0, 0, 0, 0.6);
      cursor: default;
      opacity: 0;
      transition: opacity 0.35s var(--ease-out);
    }

    .header-nav--open .header-nav__backdrop {
      opacity: 1;
    }

    .header-nav__sheet {
      display: flex;
      flex-direction: column;
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      max-height: calc(100dvh - env(safe-area-inset-top, 0px) - 3rem);
      padding: 0 1rem calc(env(safe-area-inset-bottom, 0px) + 1.5rem);
      border: 1px solid var(--border-color);
      border-bottom: 0;
      border-radius: 1.5rem 1.5rem 0 0;
      background: var(--bg-color-muted);
      box-shadow: 0 -16px 48px rgba(0, 0, 0, 0.45);
      transform: translateY(100%);
      transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
      will-change: transform;
    }

    .header-nav--open .header-nav__sheet {
      transform: none;
    }

    .header-nav__sheet:focus {
      outline: none;
    }

    .header-nav__sheet-head {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 3.75rem;
      padding-top: 0.75rem;
      touch-action: none;
      cursor: grab;
      user-select: none;
    }

    .header-nav__sheet-head:active {
      cursor: grabbing;
    }

    .header-nav__grabber {
      position: absolute;
      top: 0.5rem;
      left: 50%;
      width: 2.25rem;
      height: 0.3125rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.2);
      transform: translateX(-50%);
    }

    .header-nav__sheet-title {
      margin: 0;
      padding-left: 0.25rem;
      font-family: var(--font-title);
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--text-color);
    }

    .header-nav__close {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--hover-bg);
      color: var(--text-muted);
      cursor: pointer;
      transition:
        background var(--transition-base),
        color var(--transition-base);
      -webkit-tap-highlight-color: transparent;
    }

    .header-nav__close::before {
      content: '';
      position: absolute;
      width: 2.75rem;
      height: 2.75rem;
    }

    .header-nav__close:hover,
    .header-nav__close:active {
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-color);
    }

    .header-nav__close:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px rgba(var(--accent-rgb), 0.55);
    }

    .header-nav__close svg {
      width: 0.875rem;
      height: 0.875rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
    }

    .header-nav__links {
      flex: 0 1 auto;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0;
      margin: 0.25rem 0 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .header-nav__link,
    .header-nav__link--mobile {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 3.25rem;
      padding: 0 0.25rem;
      border-bottom: 1px solid var(--border-color);
      font-size: 1.0625rem;
      color: rgba(245, 245, 245, 0.7);
      white-space: normal;
      transition:
        color var(--transition-base),
        background-color var(--transition-base);
      -webkit-tap-highlight-color: transparent;
    }

    .header-nav__link:last-child {
      border-bottom: 0;
    }

    .header-nav__link::after,
    .header-nav__link.active::after {
      display: none;
    }

    .header-nav__link:hover,
    .header-nav__link:active {
      color: var(--text-color);
      background: linear-gradient(
        90deg,
        transparent,
        var(--hover-bg) 20%,
        var(--hover-bg) 80%,
        transparent
      );
    }

    .header-nav__link:focus-visible {
      outline: none;
      color: var(--text-color);
      box-shadow: inset 0 0 0 2px rgba(var(--accent-rgb), 0.45);
      border-radius: 0.5rem;
    }

    .header-nav__label {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
    }

    .header-nav__link.active .header-nav__label::after {
      content: '';
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 50%;
      background: var(--link-color);
    }

    .header-nav__chevron {
      display: block;
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.45;
    }

    .header-nav__meta {
      display: block;
      padding-top: 0.75rem;
      margin-top: 0.5rem;
      border-top: 1px solid var(--border-color);
    }

    .header-nav__meta :global(.social-links) {
      margin-left: -0.5rem;
    }

    :global(body:has(.header-nav--open))::after {
      content: none;
    }
  }

  @media (max-width: 480px) and (prefers-reduced-motion: reduce) {
    .header-nav__sheet {
      transform: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .header-nav--open .header-nav__sheet {
      opacity: 1;
    }
  }
</style>
