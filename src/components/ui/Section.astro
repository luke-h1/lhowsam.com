---
interface Props {
  class?: string;
  testId?: string;
}

const { class: className, testId } = Astro.props;
---

<section class:list={['section', className]} data-testid={testId}>
  <slot />
</section>

<style>
  .section {
    margin: 4rem 0;
  }

  @media (max-width: 640px) {
    .section {
      margin: 3rem 0;
    }
  }
</style>
