---
import type { CollectionEntry } from 'astro:content';
import { format } from 'date-fns';

interface Props {
  talk: CollectionEntry<'talks'>;
  analyticsSurface?: string;
  dateFormat?: string;
}

const {
  talk,
  analyticsSurface = 'talks_list',
  dateFormat = 'MMM d',
} = Astro.props;
---

<article class="entry">
  <div class="entry__head">
    <a
      class="entry__title"
      href={`/talks/${talk.data.slug}`}
      data-analytics-event="talk_click"
      data-analytics-label={talk.data.slug}
      data-analytics-surface={analyticsSurface}
    >
      {talk.data.title}
    </a>
    <time class="entry__meta" datetime={talk.data.publishedAt.toISOString()}>
      {format(talk.data.publishedAt, dateFormat)}
    </time>
  </div>
  <p class="entry__desc">{talk.data.intro}</p>
  <p class="entry__stack">{talk.data.location}</p>
</article>
