---
import type { CollectionEntry } from 'astro:content';
import { Github, Globe } from 'lucide-astro';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
  analyticsSurface?: string;
}

const {
  project,
  class: className = '',
  analyticsSurface = 'projects_list',
} = Astro.props;

const techItems =
  project.data.techStack?.map(tech => tech.name) ?? project.data.tags ?? [];

const cardClassName = ['project-card', className].filter(Boolean).join(' ');
---

<article class={cardClassName} data-testid="project-card">
  <div class="card-header">
    <div class="project-meta">
      <div class="title-group">
        <h3>
          <a
            class="title-link"
            data-testid="project-card-title"
            href={`/projects/${project.data.slug}`}
            data-analytics-event="project_click"
            data-analytics-label={project.data.slug}
            data-analytics-surface={analyticsSurface}
          >
            {project.data.title}
          </a>
        </h3>
      </div>
    </div>

    <div class="actions">
      {
        project.data.githubUrl && (
          <a
            class="icon-link"
            href={project.data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${project.data.title} on GitHub`}
            data-analytics-event="project_github_click"
            data-analytics-label={project.data.slug}
            data-analytics-surface={analyticsSurface}
          >
            <Github />
          </a>
        )
      }

      {
        project.data.siteUrl && (
          <a
            class="icon-link"
            href={project.data.siteUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${project.data.title} website`}
            data-analytics-event="project_site_click"
            data-analytics-label={project.data.slug}
            data-analytics-surface={analyticsSurface}
          >
            <Globe />
          </a>
        )
      }
    </div>
  </div>

  <div class="content">
    <p data-testid="project-card-description">{project.data.intro}</p>
  </div>

  {
    techItems.length > 0 && (
      <div class="hash-tags" aria-label="Project technologies">
        {techItems.map(tech => (
          <span class="hash-tag">{tech}</span>
        ))}
      </div>
    )
  }
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .title-group {
    min-width: 0;
  }

  .title-group h3 {
    margin: 0;
    font-family: var(--font-primary);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    background: none;
    -webkit-background-clip: unset;
    background-clip: unset;
    -webkit-text-fill-color: unset;
    color: inherit;
  }

  .title-link {
    color: var(--text-color);
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.65;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--text-muted);
    transition:
      color var(--transition-base),
      opacity var(--transition-base);
  }

  @media (pointer: coarse) {
    .icon-link {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .icon-link:hover {
    color: var(--text-color);
  }

  .actions svg {
    width: 1rem;
    height: 1rem;
  }

  .content p {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--text-base);
    line-height: 1.6;
    max-width: 42rem;
  }

  @media (max-width: 640px) {
    .card-header {
      gap: 0.75rem;
    }
  }
</style>
