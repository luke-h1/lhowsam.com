---
import type { CollectionEntry } from 'astro:content';
import { Github, Globe } from 'lucide-astro';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
  analyticsSurface?: string;
}

const {
  project,
  class: className = '',
  analyticsSurface = 'projects_list',
} = Astro.props;

const MAX_STACK_ITEMS = 6;
const techItems =
  project.data.techStack?.map(tech => tech.name) ?? project.data.tags ?? [];
const visibleTech = techItems.slice(0, MAX_STACK_ITEMS);
const hiddenTechCount = techItems.length - visibleTech.length;
---

<article class:list={['entry', className]} data-testid="project-card">
  <div class="entry__head">
    <h3 class="entry__title">
      <a
        data-testid="project-card-title"
        href={`/projects/${project.data.slug}`}
        data-analytics-event="project_click"
        data-analytics-label={project.data.slug}
        data-analytics-surface={analyticsSurface}
      >
        {project.data.title}
      </a>
    </h3>

    <div class="project-actions">
      {
        project.data.githubUrl && (
          <a
            class="project-action"
            href={project.data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${project.data.title} on GitHub`}
            data-analytics-event="project_github_click"
            data-analytics-label={project.data.slug}
            data-analytics-surface={analyticsSurface}
          >
            <Github />
          </a>
        )
      }
      {
        project.data.siteUrl && (
          <a
            class="project-action"
            href={project.data.siteUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${project.data.title} website`}
            data-analytics-event="project_site_click"
            data-analytics-label={project.data.slug}
            data-analytics-surface={analyticsSurface}
          >
            <Globe />
          </a>
        )
      }
    </div>
  </div>

  <p class="entry__desc" data-testid="project-card-description">
    {project.data.intro}
  </p>

  {
    techItems.length > 0 && (
      <p class="entry__stack">
        <span class="sr-only">Built with: </span>
        {visibleTech.join(' / ')}
        {hiddenTechCount > 0 && ` +${hiddenTechCount}`}
      </p>
    )
  }
</article>

<style>
  .project-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-right: -0.4rem;
  }

  .project-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.375rem;
    color: rgba(255, 255, 255, 0.45);
    transition: color var(--transition-base);
  }

  .project-action::after {
    content: none;
  }

  .project-action:hover {
    color: var(--text-color);
  }

  .project-action:focus-visible {
    outline: 2px solid var(--link-color);
    outline-offset: 2px;
  }

  .project-action :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (pointer: coarse) {
    .project-action {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
