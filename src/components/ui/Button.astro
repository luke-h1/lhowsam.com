---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?:
    | 'default'
    | 'destructive'
    | 'outline'
    | 'secondary'
    | 'ghost'
    | 'link';
  size?: 'default' | 'sm' | 'lg' | 'icon';
  href?: HTMLAttributes<'a'>['href'];
  target?: HTMLAttributes<'a'>['target'];
  rel?: string;
}

const {
  variant = 'default',
  size = 'default',
  class: className,
  ...props
} = Astro.props;

const Tag = props.href ? 'a' : 'button';
---

<Tag
  class:list={['ui-button', className]}
  data-variant={variant}
  data-size={size}
  {...props}
>
  <slot />
</Tag>

<style is:global>
  .ui-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    border-radius: calc(var(--radius) - 2px);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    border: 1px solid transparent;
    background: transparent;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      text-decoration 0.15s ease;
  }

  .ui-button:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px hsl(var(--background)),
      0 0 0 4px hsl(var(--ring));
  }

  .ui-button:disabled {
    pointer-events: none;
    opacity: 0.5;
  }

  /* Sizes */
  .ui-button[data-size='default'] {
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
  }

  .ui-button[data-size='sm'] {
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border-radius: calc(var(--radius) - 2px);
  }

  .ui-button[data-size='lg'] {
    min-height: 2.75rem;
    padding: 0 2rem;
    border-radius: calc(var(--radius) - 2px);
  }

  .ui-button[data-size='icon'] {
    width: 2.5rem;
    min-height: 2.5rem;
    padding: 0;
  }

  /* Variants */
  .ui-button[data-variant='default'] {
    background-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }

  .ui-button[data-variant='default']:hover {
    background-color: hsl(var(--primary) / 0.9);
  }

  .ui-button[data-variant='destructive'] {
    background-color: hsl(var(--destructive));
    color: hsl(var(--destructive-foreground));
  }

  .ui-button[data-variant='destructive']:hover {
    background-color: hsl(var(--destructive) / 0.9);
  }

  .ui-button[data-variant='outline'] {
    border-color: hsl(var(--input));
    background-color: hsl(var(--background));
  }

  .ui-button[data-variant='outline']:hover {
    background-color: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  .ui-button[data-variant='secondary'] {
    background-color: hsl(var(--secondary));
    color: hsl(var(--secondary-foreground));
  }

  .ui-button[data-variant='secondary']:hover {
    background-color: hsl(var(--secondary) / 0.8);
  }

  .ui-button[data-variant='ghost']:hover {
    background-color: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  .ui-button[data-variant='link'] {
    color: hsl(var(--primary));
    text-underline-offset: 4px;
    border-color: transparent;
    background: transparent;
  }

  .ui-button[data-variant='link']:hover {
    text-decoration: underline;
  }
</style>
