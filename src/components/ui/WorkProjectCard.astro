---
import type { CollectionEntry } from 'astro:content';
import { format } from 'date-fns';

interface Props {
  project: CollectionEntry<'workProjects'>;
}

const { project } = Astro.props;
---

<article class="entry">
  <div class="entry__head">
    <a class="entry__title" href={`/work-projects/${project.data.slug}`}>
      {project.data.title}
    </a>
    <time class="entry__meta" datetime={project.data.publishedAt.toISOString()}>
      {format(project.data.publishedAt, 'MMM')}
    </time>
  </div>
  <p class="entry__desc">{project.data.intro}</p>
</article>
