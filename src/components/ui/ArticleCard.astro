---
import type { CollectionEntry } from 'astro:content';
import { format } from 'date-fns';
import { toTagSlug } from '../../util/tags';

interface Props {
  post: CollectionEntry<'blog'>;
  analyticsSurface?: string;
  dateFormat?: string;
}

const {
  post,
  analyticsSurface = 'blog_list',
  dateFormat = 'MMM d, yyyy',
} = Astro.props;
---

<article class="entry" data-testid="blog-post-card">
  <div class="entry__head">
    <a
      class="entry__title"
      data-testid="blog-post-card-title"
      href={`/blog/${post.data.slug}`}
      data-analytics-event="blog_post_click"
      data-analytics-label={post.data.slug}
      data-analytics-surface={analyticsSurface}
    >
      {post.data.title}
    </a>
    <time class="entry__meta" datetime={post.data.publishedAt.toISOString()}>
      {format(post.data.publishedAt, dateFormat)}
    </time>
  </div>
  <p class="entry__desc" data-testid="blog-post-card-intro">
    {post.data.intro}
  </p>
  {
    post.data.tags.length > 0 && (
      <div class="hash-tags">
        {post.data.tags.map(tag => (
          <a class="hash-tag" href={`/blog/tags/${toTagSlug(tag)}/`}>
            {tag}
          </a>
        ))}
      </div>
    )
  }
</article>
