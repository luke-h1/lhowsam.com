---
interface Props {
  title: string;
  description: string;
  titleTestId?: string;
  descriptionTestId?: string;
}

const {
  title,
  description,
  titleTestId = 'page-title',
  descriptionTestId = 'page-hero-description',
} = Astro.props;
---

<section class="hero">
  <h1 data-testid={titleTestId}>{title}</h1>
  <p class="subtitle" data-testid={descriptionTestId}>{description}</p>
</section>

<style>
  .hero {
    padding: 3.5rem 0 3rem;
  }

  .hero h1 {
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
  }

  .subtitle {
    margin: 0;
    max-width: 36rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2rem 0 2.25rem;
    }
  }
</style>
