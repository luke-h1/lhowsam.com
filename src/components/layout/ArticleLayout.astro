---
import { format } from 'date-fns';
import TableOfContents from '../blog/TableOfContents.astro';
import BaseLayout from './BaseLayout.astro';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  headings?: Heading[];
  publishedAt?: Date;
  intro?: string;
  image?: string;
  canonicalURL?: string | URL;
  pageType?: 'website' | 'article' | 'profile';
  structuredData?: object | object[];
  updatedAt?: Date;
}

const {
  title,
  seoTitle = title,
  description,
  headings = [],
  publishedAt,
  intro,
  image,
  canonicalURL,
  pageType = 'article',
  structuredData,
  updatedAt,
} = Astro.props;

const hasToc = headings.some(h => h.depth >= 2 && h.depth <= 4);
---

<BaseLayout
  title={seoTitle}
  description={description}
  image={image}
  canonicalURL={canonicalURL}
  pageType={pageType}
  structuredData={structuredData}
  publishedTime={publishedAt?.toISOString()}
  modifiedTime={(updatedAt ?? publishedAt)?.toISOString()}
>
  <div class:list={['post-page', hasToc && 'post-page--with-toc']}>
    {
      hasToc && (
        <div class="post-toc-mobile">
          <TableOfContents headings={headings} collapsible />
        </div>
      )
    }
    <div class="post-layout">
      <article class="post" lang="en">
        <header class="post-header">
          <h1 class="post-title" data-testid="article-title">{title}</h1>
          {
            publishedAt && (
              <time
                class="post-date"
                data-testid="article-published-at"
                datetime={publishedAt.toISOString()}
              >
                {format(publishedAt, 'MMMM d, yyyy')}
              </time>
            )
          }
          {intro && <p class="post-intro">{intro}</p>}
          <slot name="headerExtras" />
        </header>
        <div class="content" data-testid="article-body">
          <slot />
        </div>
      </article>
      {
        hasToc && (
          <aside class="post-toc-aside">
            <div class="post-toc-sticky">
              <TableOfContents headings={headings} />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const copyToClipboard = text =>
      navigator.clipboard
        ? navigator.clipboard.writeText(text)
        : Promise.reject();

    const flash = (el, message, originalText, succeeded = true) => {
      if (succeeded) el.classList.add('copied');
      el.textContent = message;
      window.setTimeout(() => {
        el.classList.remove('copied');
        el.textContent = originalText;
      }, 1600);
    };

    const getHeadingText = heading =>
      [...heading.childNodes]
        .filter(node => node.nodeType === Node.TEXT_NODE)
        .map(node => node.textContent)
        .join('')
        .trim();

    document
      .querySelectorAll('.content :is(h2, h3, h4)[id]')
      .forEach(heading => {
        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = `#${heading.id}`;
        anchor.textContent = '#';
        anchor.title = 'Copy link to section';
        anchor.setAttribute(
          'aria-label',
          `Copy link to "${getHeadingText(heading)}"`,
        );
        anchor.addEventListener('click', event => {
          event.preventDefault();
          const url = new URL(`#${heading.id}`, window.location.href);
          history.replaceState(null, '', url);
          copyToClipboard(url.toString()).catch(() => {
            window.location.hash = heading.id;
          });
        });
        heading.appendChild(anchor);
      });

    document.querySelectorAll('.content pre.astro-code').forEach(pre => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.replaceWith(wrapper);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'content-copy-code';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.addEventListener('click', () => {
        const code = pre.querySelector('code')?.innerText ?? pre.innerText;
        copyToClipboard(code.replace(/\n$/, ''))
          .then(() => flash(button, 'Copied', 'Copy'))
          .catch(() => flash(button, 'Failed', 'Copy', false));
      });

      wrapper.append(pre, button);
    });
  })();
</script>
