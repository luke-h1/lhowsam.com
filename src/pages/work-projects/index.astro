---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Hero from '../../components/Hero.astro';
import Group from '../../components/ui/Group.astro';
import { groupByYear } from '../../util/groupByYear';
import WorkProjectCard from '../../components/ui/WorkProjectCard.astro';
import { siteConfig } from '../../config/site';

const projects = await getCollection('workProjects', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sorted = projects.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const title = `Work projects | ${siteConfig.authorName}`;
const description =
  'Case studies and client work from Luke Howsam — full-stack development, React, React Native, and delivery.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: `${siteConfig.siteUrl}/work-projects/`,
    description,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: sorted.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${siteConfig.siteUrl}/work-projects/${entry.data.slug}/`,
        name: entry.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteConfig.siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Work projects',
        item: `${siteConfig.siteUrl}/work-projects/`,
      },
    ],
  },
];
const byYear = groupByYear(sorted, item => item.data.publishedAt);
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Container>
    <Hero title="Work projects" description="Case studies and deep dives" />
    {
      byYear.map(group => (
        <Group label={String(group.year)} id={`year-${group.year}`}>
          {group.items.map(item => (
            <WorkProjectCard project={item} />
          ))}
        </Group>
      ))
    }
  </Container>
</BaseLayout>
