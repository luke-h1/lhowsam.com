---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Hero from '../../components/Hero.astro';
import ContentList from '../../components/ContentList.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import { siteConfig } from '../../config/site';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const title = `Blog | ${siteConfig.authorName}`;
const description =
  'Blog posts from Luke Howsam about React Native, TypeScript, software development, backend systems, and DevOps.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: `${siteConfig.siteUrl}/blog/`,
    description,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: sortedPosts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${siteConfig.siteUrl}/blog/${post.data.slug}/`,
        name: post.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteConfig.siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: `${siteConfig.siteUrl}/blog/`,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Container>
    <Hero title="Blog" description="Read my latest blog posts" />
    <ContentList testId="blog-post-list">
      {
        sortedPosts.map(post => (
          <ArticleCard post={post} analyticsSurface="blog_index" />
        ))
      }
    </ContentList>
  </Container>
</BaseLayout>
