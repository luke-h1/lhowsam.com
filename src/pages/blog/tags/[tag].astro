---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../../components/ui/ArticleCard.astro';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Group from '../../../components/ui/Group.astro';
import Hero from '../../../components/Hero.astro';
import { siteConfig } from '../../../config/site';
import { isIndexableTagPage } from '../../../util/tagIndex';
import { tagPageDescription, toTagSlug } from '../../../util/tags';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const tagMap = new Map<string, string>();

  posts.forEach(post => {
    post.data.tags.forEach(tag => {
      tagMap.set(toTagSlug(tag), tag);
    });
  });

  return [...tagMap.entries()].map(([tag, label]) => ({
    params: { tag },
    props: {
      tag,
      label,
      posts: posts
        .filter(post =>
          post.data.tags.some(postTag => toTagSlug(postTag) === tag),
        )
        .sort(
          (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
        ),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, label, posts } = Astro.props;
const title = `${label} | Blog Tags | ${siteConfig.authorName}`;
const description = tagPageDescription(
  label,
  posts.map(post => post.data.title),
  siteConfig.authorName,
);
const tagUrl = `${siteConfig.siteUrl}/blog/tags/${tag}/`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: tagUrl,
    description,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${siteConfig.siteUrl}/blog/${post.data.slug}/`,
        name: post.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteConfig.siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: `${siteConfig.siteUrl}/blog/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Tags',
        item: `${siteConfig.siteUrl}/blog/tags/`,
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: label,
        item: tagUrl,
      },
    ],
  },
];
const robots = isIndexableTagPage(posts.length)
  ? 'index,follow,max-image-preview:large'
  : 'noindex,follow';
---

<BaseLayout
  title={title}
  description={description}
  robots={robots}
  structuredData={structuredData}
>
  <Container>
    <Hero
      title={`Posts tagged with "${label}"`}
      description={`${posts.length} matching post${posts.length === 1 ? '' : 's'}`}
    />
    <p class="page-links">
      <a href="/blog/tags/">All tags →</a>
      <a href="/blog/">All posts →</a>
    </p>
    <Group label="Posts" id="tagged-posts">
      {
        posts.map(post => (
          <ArticleCard post={post} analyticsSurface="blog_tag_index" />
        ))
      }
    </Group>
  </Container>
</BaseLayout>
