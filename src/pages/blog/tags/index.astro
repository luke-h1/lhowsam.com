---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Hero from '../../../components/Hero.astro';
import Group from '../../../components/ui/Group.astro';
import { siteConfig } from '../../../config/site';
import { toTagSlug } from '../../../util/tags';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const tagCounts = posts.reduce((accumulator, post) => {
  post.data.tags.forEach(tag => {
    const existing = accumulator.get(tag);

    if (existing) {
      existing.count += 1;
      return;
    }

    accumulator.set(tag, {
      label: tag,
      slug: toTagSlug(tag),
      count: 1,
    });
  });

  return accumulator;
}, new Map<string, { label: string; slug: string; count: number }>());

const tags = [...tagCounts.values()].sort((a, b) =>
  a.label.localeCompare(b.label),
);

const title = `Blog Tags | ${siteConfig.authorName}`;
const description = 'Browse blog posts by tag.';
---

<BaseLayout title={title} description={description}>
  <Container>
    <Hero title="Blog tags" description="Browse posts by topic" />
    <p class="page-links">
      <a href="/blog/">All posts →</a>
    </p>
    <Group label={`${tags.length} tags`} id="all-tags">
      <ul class="tag-list">
        {
          tags.map(tag => (
            <li>
              <a class="tag-row" href={`/blog/tags/${tag.slug}/`}>
                <span class="tag-row__label">#{tag.label}</span>
                <span class="tag-row__count">{tag.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </Group>
  </Container>
</BaseLayout>

<style>
  .tag-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    margin: 0;
  }

  .tag-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.72);
    transition: color var(--transition-base);
  }

  .tag-row::after {
    content: none;
  }

  .tag-row:hover {
    color: var(--text-color);
  }

  .tag-row__count {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.52);
  }
</style>
