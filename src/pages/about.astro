---
import { experience, getExperienceRoleAnchor } from '../data/experience';
import { formatDateRange } from '../util/dateRange';
import BaseLayout from '../components/layout/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { siteConfig } from '../config/site';
import { absoluteUrl } from '../util/seo';
import lukeImage from '../assets/luke.png';
import appJsConfImage from '../assets/work-projects/sporting-life-mobile-inline-1.jpg';
import appJsConf2026Image from '../assets/about/appjs-2026.jpg';
import fishImage from '../assets/about/fish.jpg';
import PolaroidStack from '../components/ui/PolaroidStack.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';

const photos = [
  {
    src: lukeImage,
    alt: 'Luke sitting on stone steps in front of a red door',
    caption: '🇳🇱 2025',
  },
  {
    src: appJsConfImage,
    alt: 'A polaroid of Luke and the team in front of the App.js Conf backdrop in Kraków',
    caption: 'App.js 2025',
  },
  {
    src: appJsConf2026Image,
    alt: 'Luke and the team smiling on a rooftop terrace at night, with Wawel Castle lit up over Kraków behind them',
    caption: 'App.js 2026',
  },
  {
    src: fishImage,
    caption: '🎣',
    alt: 'Luke crouching on a lake bank, smiling and holding up a large common carp',
  },
] satisfies { src: ImageMetadata; alt: string; caption: string }[];

const companies = experience.map(company => ({
  ...company,
  roles: [...company.roles]
    .sort((a, b) => b.from.localeCompare(a.from))
    .map(role => ({
      ...role,
      anchor: getExperienceRoleAnchor(company.slug, role.title, role.from),
    })),
}));

const title = `About ${siteConfig.authorName} | Software Developer`;
const description =
  'Learn more about Luke Howsam, a software developer focused on React Native, TypeScript, mobile engineering, backend systems, and DevOps.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: title,
    url: `${siteConfig.siteUrl}/about`,
    description,
    mainEntity: {
      '@type': 'Person',
      name: siteConfig.authorName,
      url: siteConfig.siteUrl,
      image: absoluteUrl(lukeImage.src),
      jobTitle: siteConfig.authorJobTitle,
      sameAs: siteConfig.socialLinks.map(link => link.url),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteConfig.siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'About',
        item: `${siteConfig.siteUrl}/about`,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  pageType="profile"
  structuredData={structuredData}
>
  <Container>
    <section class="about-hero">
      <div class="about-hero__copy">
        <h1 data-testid="about-page-title">Luke Howsam</h1>
        <p class="about-headline" data-testid="about-page-headline">
          Software Developer focused on React Native + mobile, backend
          engineering and DevOps
        </p>

        <div class="about-bio">
          <p>
            I'm a software developer who likes building polished products, but
            I'm just as interested in how they're shipped and run. That
            typically involves a mix of React Native, AI & backend systems,
            CI/CD and cloud infrastructure.
          </p>
        </div>

        <div class="about-links">
          <a
            class="about-links__cv"
            href="/static/cv.pdf"
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="cv_click"
            data-analytics-label="about_cv"
            data-analytics-surface="about_hero"
          >
            CV
          </a>
          <SocialLinks />
        </div>
      </div>

      <PolaroidStack photos={photos} label="Photos of Luke" />
    </section>

    <a
      class="about-row-link"
      href="/how-i-work/"
      data-testid="about-how-i-work-link"
    >
      <span class="about-row-link__label">How I work</span>
      <span class="about-row-link__text">
        The principles I use to build, ship and run software
      </span>
      <span class="about-row-link__arrow" aria-hidden="true">→</span>
    </a>

    <section class="about-experience" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="about-section-label">Experience</h2>

      {
        companies.map(company => (
          <section class="about-company">
            <header class="about-company__header">
              <h3>{company.company}</h3>
              <p class="about-company__meta">
                <span>{company.roles[0]?.location}</span>
                <span>
                  {formatDateRange(
                    company.from,
                    company.isPresent ? null : company.to,
                    'yyyy',
                  )}
                </span>
              </p>
            </header>

            <div class="about-roles">
              {company.roles.map(role => (
                <article
                  class="about-role"
                  id={role.anchor}
                  data-testid={`experience-${role.anchor}`}
                >
                  <header class="about-role__header">
                    <h4>{role.title}</h4>
                    <span class="about-role__dates">
                      {formatDateRange(role.from, role.to)}
                    </span>
                  </header>
                  <p class="about-role__summary">{role.summary}</p>
                  <ul class="about-role__achievements">
                    {role.achievements.map(achievement => (
                      <li>{achievement}</li>
                    ))}
                  </ul>
                  <p class="about-role__stack">
                    <span class="sr-only">Tech stack: </span>
                    {role.techStack.join(' / ')}
                  </p>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </Container>
</BaseLayout>
