---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Group from '../components/ui/Group.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import TalkCard from '../components/ui/TalkCard.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import { siteConfig } from '../config/site';
import { sortProjects } from '../util/projects';
import { absoluteUrl } from '../util/seo';
import { format } from 'date-fns';
import lukeImage from '../assets/luke.png';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const recentPosts = posts
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const projects = await getCollection('projects');

const featuredProjects = sortProjects(projects).filter(
  project => project.data.featured,
);
const talks = await getCollection('talks', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const recentTalks = talks
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 2);

const title = siteConfig.defaultTitle;
const description =
  'Luke Howsam is a software developer writing about React Native, TypeScript, mobile engineering, backend systems, and DevOps.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
    description,
    author: {
      '@type': 'Person',
      name: siteConfig.authorName,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: siteConfig.authorName,
    url: siteConfig.siteUrl,
    image: absoluteUrl(lukeImage.src),
    jobTitle: siteConfig.authorJobTitle,
    sameAs: siteConfig.socialLinks.map(link => link.url),
    knowsAbout: [
      'React Native',
      'TypeScript',
      'Mobile Engineering',
      'Backend Development',
      'DevOps',
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Container>
    <section class="home-hero" data-testid="home-hero">
      <h1 data-testid="home-page-title">luke-h1</h1>
      <p class="home-hero__subtitle">
        <span data-testid="home-author-name">Luke Howsam</span>
        <span aria-hidden="true">·</span>
        <span>Software Developer</span>
      </p>
      <p class="home-hero__intro" data-testid="home-intro">
        SWE interested in React Native, Mobile, DevOps, TypeScript and all
        things in-between
      </p>
      <div class="home-hero__links">
        <SocialLinks />
      </div>
    </section>

    <Group
      label="Writing"
      href="/blog"
      testId="home-recent-posts"
      headingTestId="home-recent-posts-heading"
      id="home-writing"
    >
      {
        recentPosts.map(post => (
          <article class="entry" data-testid="home-recent-post-card">
            <div class="entry__head">
              <a
                class="entry__title"
                href={`/blog/${post.data.slug}`}
                data-testid="home-recent-post-title"
                data-analytics-event="blog_post_click"
                data-analytics-label={post.data.slug}
                data-analytics-surface="home_recent_posts"
              >
                {post.data.title}
              </a>
              <time
                class="entry__meta"
                data-testid="home-recent-post-date"
                datetime={post.data.publishedAt.toISOString()}
              >
                {format(post.data.publishedAt, 'MMM d, yyyy')}
              </time>
            </div>
            <p class="entry__desc" data-testid="home-recent-post-intro">
              {post.data.intro}
            </p>
          </article>
        ))
      }
    </Group>

    <Group label="Projects" href="/projects" id="home-projects">
      {
        featuredProjects.map(project => (
          <ProjectCard
            project={project}
            analyticsSurface="home_featured_projects"
          />
        ))
      }
    </Group>

    {
      recentTalks.length > 0 && (
        <Group label="Talks" href="/talks/" id="home-talks">
          {recentTalks.map(talk => (
            <TalkCard
              talk={talk}
              analyticsSurface="home_talks"
              dateFormat="MMM d, yyyy"
            />
          ))}
        </Group>
      )
    }
  </Container>
</BaseLayout>

<style>
  .home-hero {
    max-width: 40rem;
    padding: 3.5rem 0 4rem;
  }

  .home-hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .home-hero__subtitle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .home-hero__subtitle span[aria-hidden] {
    opacity: 0.5;
  }

  .home-hero__intro {
    margin: 1.5rem 0 0;
    font-size: 1rem;
    line-height: 1.75;
    color: #d4d4d8;
  }

  .home-hero__links {
    margin: 1.5rem 0 0 -0.5rem;
  }

  @media (max-width: 640px) {
    .home-hero {
      padding: 2rem 0 2.5rem;
    }
  }
</style>
