---
import { getCollection } from 'astro:content';
import ContentList from '../components/ContentList.astro';
import BaseLayout from '../components/layout/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import { siteConfig } from '../config/site';
import { absoluteUrl } from '../util/seo';
import { toTagSlug } from '../util/tags';
import { format } from 'date-fns';
import lukeImage from '../assets/luke.png';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const recentPosts = posts
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const projects = await getCollection('projects');

const featuredProjects = projects.filter(project => project.data.featured);
const title = siteConfig.defaultTitle;
const description =
  'Luke Howsam is a software developer writing about React Native, TypeScript, mobile engineering, backend systems, and DevOps.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
    description,
    author: {
      '@type': 'Person',
      name: siteConfig.authorName,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: siteConfig.authorName,
    url: siteConfig.siteUrl,
    image: absoluteUrl(lukeImage.src),
    jobTitle: siteConfig.authorJobTitle,
    sameAs: siteConfig.socialLinks.map(link => link.url),
    knowsAbout: [
      'React Native',
      'TypeScript',
      'Mobile Engineering',
      'Backend Development',
      'DevOps',
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Container>
    <section class="hero" data-testid="home-hero">
      <h1 data-testid="home-page-title">luke-h1</h1>
      <p class="subtitle">
        <span data-testid="home-author-name">Luke Howsam</span>
        <span class="subtitle__sep" aria-hidden="true">·</span>
        <span>Software Developer</span>
      </p>
      <p class="intro" data-testid="home-intro">
        SWE interested in React Native, Mobile, DevOps, TypeScript and all
        things in-between
      </p>
      <div class="social-links">
        {
          siteConfig.socialLinks.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.name}
              <span class="ext-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>
    <Section testId="home-recent-posts">
      <div class="section-header">
        <h2 data-testid="home-recent-posts-heading">Recent blog posts</h2>
        <a href="/blog">View all</a>
      </div>
      <ContentList>
        {
          recentPosts.map(post => (
            <article data-testid="home-recent-post-card">
              <div class="title-row">
                <a
                  href={`/blog/${post.data.slug}`}
                  data-testid="home-recent-post-title"
                  data-analytics-event="blog_post_click"
                  data-analytics-label={post.data.slug}
                  data-analytics-surface="home_recent_posts"
                >
                  {post.data.title}
                </a>
                <time
                  data-testid="home-recent-post-date"
                  datetime={post.data.publishedAt.toISOString()}
                >
                  {format(post.data.publishedAt, 'MMM d, yyyy')}
                </time>
              </div>
              <p class="muted-text" data-testid="home-recent-post-intro">
                {post.data.intro}
              </p>
              {post.data.tags.length > 0 && (
                <div class="hash-tags">
                  {post.data.tags.map(tag => (
                    <a class="hash-tag" href={`/blog/tags/${toTagSlug(tag)}/`}>
                      {tag}
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </ContentList>
    </Section>
    <section class="section">
      <div class="section-header">
        <h2>Recent projects</h2>
        <a href="/projects">View all</a>
      </div>
      <ContentList>
        {
          featuredProjects.map(project => (
            <article>
              <div class="title-row">
                <a
                  class="project-title"
                  href={`/projects/${project.data.slug}`}
                  data-analytics-event="project_click"
                  data-analytics-label={project.data.slug}
                  data-analytics-surface="home_featured_projects"
                >
                  {project.data.title}
                </a>
              </div>
              <p class="muted-text">{project.data.intro}</p>
              {project.data.techStack && (
                <div class="hash-tags">
                  {project.data.techStack.map(stack => (
                    <span class="hash-tag">{stack.name}</span>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </ContentList>
    </section>
  </Container>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 0;
  }

  .hero > * {
    margin: 0;
  }

  .hero > * + * {
    margin-top: 0.5rem;
  }

  .hero .intro {
    margin-top: 1rem;
  }

  .subtitle__sep {
    margin: 0 0.4rem;
    opacity: 0.5;
  }

  .introduction {
    margin: 1.5rem 0;
    opacity: 0.9;
  }

  .section {
    margin: 4rem 0;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .section-header h2 {
    margin-bottom: 0;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--text-sm);
  }

  article .muted-text {
    margin-bottom: 0;
  }

  .project-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-color);
    text-decoration: none;
  }

  .project-title:hover {
    color: var(--text-muted);
    text-decoration: underline;
  }

  /* experience */
  .company-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .company-logo {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    opacity: 0.55;
    white-space: nowrap;
  }

  .social-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }

  .ext-arrow {
    display: inline-block;
    margin-left: 0.2em;
    font-size: 0.75em;
    opacity: 0.55;
    transition:
      transform 160ms var(--ease-out),
      opacity 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .social-links a:hover .ext-arrow {
      transform: translate(1px, -1px);
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    main {
      padding: 1rem 0;
    }

    .hero {
      padding: 3rem 0;
    }

    .section-header,
    .title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    .container {
      padding: 0 1rem;
    }
  }
</style>
