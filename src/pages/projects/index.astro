---
import { getCollection } from 'astro:content';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Group from '../../components/ui/Group.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { siteConfig } from '../../config/site';
import { sortProjects } from '../../util/projects';

const projects = await getCollection('projects');

const sortedProjects = sortProjects(projects);

const featuredProjects = sortedProjects.filter(
  project => project.data.featured,
);
const allProjects = sortedProjects.filter(project => !project.data.featured);
const title = `Projects | ${siteConfig.authorName}`;
const description =
  'Projects built by Luke Howsam across React Native, TypeScript, web, mobile, and developer tooling.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    url: `${siteConfig.siteUrl}/projects/`,
    description,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: sortedProjects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${siteConfig.siteUrl}/projects/${project.data.slug}/`,
        name: project.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteConfig.siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Projects',
        item: `${siteConfig.siteUrl}/projects/`,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Container>
    <Hero title="Projects" description="Open source apps" />
    {
      featuredProjects.length > 0 && (
        <Group label="Featured" id="featured-projects">
          {featuredProjects.map(project => (
            <ProjectCard project={project} analyticsSurface="projects_index" />
          ))}
        </Group>
      )
    }
    {
      allProjects.length > 0 && (
        <Group label="Other" id="all-projects">
          {allProjects.map(project => (
            <ProjectCard project={project} analyticsSurface="projects_index" />
          ))}
        </Group>
      )
    }
  </Container>
</BaseLayout>
